{
  "name": "linguae",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://linguae.martonpaulo.com/",
  "author": {
    "name": "Marton Paulo",
    "email": "info@martonpaulo.com",
    "url": "https://www.martonpaulo.com"
  },
  "description": "Interactive table featuring all documented languages from the Wikitongues database, providing an easy way to explore global linguistic diversity.",
  "keywords": [
    "language",
    "linguistics",
    "culture",
    "diversity",
    "world",
    "global",
    "interactive",
    "table",
    "catalogue",
    "database",
    "Wikitongues"
  ],
  "repository": "github:martonpaulo/linguae",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "playwright test",
    "validate": "pnpm lint && pnpm exec tsc --noEmit --incremental false && pnpm test",
    "test:chromium": "playwright test --project=chromium",
    "snapshot": "tsx --env-file-if-exists=.env.local scripts/generate-snapshot.ts",
    "snapshot:fixture": "tsx scripts/generate-snapshot.ts --fixture",
    "build:export": "next build",
    "serve:export": "tsx scripts/serve-export.ts",
    "snapshot:scaled": "tsx scripts/generate-snapshot.ts --scale=8000",
    "measure:derivation": "tsx scripts/measure-derivation.ts",
    "lint:fix": "eslint . --fix",
    "social-card": "tsx scripts/generate-social-card.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.4.2",
    "@mui/material": "^6.4.2",
    "@mui/material-nextjs": "^6.4.2",
    "@tanstack/react-query": "^5.66.0",
    "next": "15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.7.0"
}
